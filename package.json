{
  "name": "myn-ai-desktop",
  "version": "2.0.0",
  "description": "MYN AI macOS Client",
  "main": "main.js",
  "scripts": {
    "postinstall": "echo 'Native modules may need manual rebuild: npm run rebuild'",
    "rebuild": "npx --cache /tmp/npm-cache --yes @electron/rebuild",
    "dev": "vite",
    "build": "vite build",
    "pack": "vite build && electron-builder --mac",
    "start": "electron ."
  },
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.1.48",
    "@langchain/openai": "^1.4.7",
    "better-sqlite3": "^9.4.3",
    "cheerio": "^1.2.0",
    "langchain": "^1.4.4",
    "lucide-react": "^0.344.0",
    "marked": "^18.0.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4"
  },
  "build": {
    "appId": "com.myn.ai.desktop",
    "productName": "MYN AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "package.json",
      "utils/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}